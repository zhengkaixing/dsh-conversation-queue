{
  "name": "dsh-conversation-queue",
  "version": "0.3.0",
  "type": "module",
  "description": "Cap how many DeepSeek Harness conversations run at once (FIFO queue for the rest), plus a memory/commit/disk status strip in the web UI.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "concurrency",
    "queue",
    "memory",
    "statusline"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "sampler.ps1",
    "volumes.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/*.png"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
